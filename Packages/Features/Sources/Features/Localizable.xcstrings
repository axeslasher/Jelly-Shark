    "liveTV.card.channelNext %@ %@ %@": {
      "comment": "Second line of a live TV card in the player's guide. Values: the channel, the next programme, and when it starts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · Next: %2$@ %3$@"
          }
        }
      }
    },
    "liveTV.card.channelUntil %@ %@": {
      "comment": "Second line of a live TV card. First value is the channel, second is when the programme ends.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · until %2$@"
          }
        }
      }
    },
    "liveTV.guide.minutesLeft %lld": {
      "comment": "How many minutes remain of the live TV programme that has focus.",
