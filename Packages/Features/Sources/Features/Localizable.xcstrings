      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to This Profile"
          }
        }
      }
    },
    "server.profile.switchFailed %@ %@": {
      "comment": "Shown when switching to a saved profile failed and the app went back to the previous one. The first variable is the profile's name, the second the reason.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't switch to %1$@. %2$@"
          }
        }
      }
    },
    "server.profiles.add": {
      "comment": "Row that opens the form for signing in to another server or user.",
