{
  "sourceLanguage": "en",
  "strings": {
    "addProfile.navigationTitle": {
      "comment": "Title of the screen for signing in to another server or user.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Profile"
          }
        }
      }
    },
    "addProfile.subtitle": {
      "comment": "Subheading of the screen for signing in to another server or user. The current sign-in is kept.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to another server or user. You'll stay signed in here too, so you can switch back."
          }
        }
      }
    },
    "affinity.shelf.failed": {
      "comment": "Heading of the Home shelves picked from the viewer’s history, when they failed to load.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picks for you"
          }
        }
      }
    },
    "common.cancel": {
      "comment": "Button that dismisses a prompt without choosing anything.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      }
    },
    "common.close": {
      "comment": "Button that dismisses the current overlay or screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        }
      }
    },
    "detail.action.favorite": {
