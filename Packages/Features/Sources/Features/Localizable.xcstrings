    "server.profile.busy": {
      "comment": "Shown when a press is ignored because a profile change is still finishing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finishing the last profile change. Try again in a moment."
          }
        }
      }
    },
    "server.profile.forget": {
      "comment": "Dialog button that signs the chosen saved account out and removes it from this device.",
