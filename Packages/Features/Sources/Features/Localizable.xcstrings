  "strings": {
    "common.cancel": {
      "comment": "Button that dismisses a prompt without choosing anything.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      }
    },
    "common.close": {
      "comment": "Button that dismisses the current overlay or screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        }
      }
