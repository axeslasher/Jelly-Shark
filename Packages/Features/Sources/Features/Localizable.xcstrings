{
  "sourceLanguage": "en",
  "strings": {
    "addProfile.navigationTitle": {
      "comment": "Title of the screen for signing in to another server or user.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Profile"
          }
        }
      }
    },
    "addProfile.subtitle": {
      "comment": "Subheading of the screen for signing in to another server or user. The current sign-in is kept.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to another server or user. You'll stay signed in here too, so you can switch back."
          }
        }
      }
    },
    "common.cancel": {
      "comment": "Button that dismisses a prompt without choosing anything.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      }
    },
    "common.close": {
      "comment": "Button that dismisses the current overlay or screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        }
      }
    },
    "genre.card.shuffleImage": {
      "comment": "Menu action that shows a different backdrop on a genre card.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shuffle image"
          }
        }
      }
    },
    "home.empty.openSettings": {
      "comment": "Button on an empty Home screen that opens Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        }
      }
    },
    "home.empty.title": {
      "comment": "Home heading when signed in but the server has nothing to show.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing here yet"
          }
        }
      }
    },
    "home.hero.play": {
      "comment": "Home hero button that starts an item from the beginning.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play"
          }
        }
      }
    },
    "home.hero.resume": {
      "comment": "Home hero button that continues a partly watched item.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume"
          }
        }
      }
    },
    "home.welcome.connect": {
      "comment": "Button on the first-run Home screen that opens Settings to connect a server.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect in Settings"
          }
        }
      }
    },
    "home.welcome.title": {
      "comment": "Home heading before the user has connected a server. Jelly Shark is the app name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to Jelly Shark"
          }
        }
      }
    },
    "libraries.pageTitle": {
      "comment": "Heading of the page listing the user's media libraries.",
