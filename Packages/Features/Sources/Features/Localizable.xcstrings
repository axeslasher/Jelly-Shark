      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forget This Profile"
          }
        }
      }
    },
    "server.profile.switch": {
      "comment": "Dialog button that switches the app to the chosen saved server sign-in.",
