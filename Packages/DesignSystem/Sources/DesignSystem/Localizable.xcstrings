    "theme.action.description": {
      "comment": "One-line summary of a visual theme's mood.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinetic energy, technological precision. Fast, explosive motion with electric cyan highlights."
          }
        }
      }
    },
    "theme.action.name": {
      "comment": "Name of a visual theme, shown in Settings. Themes are named after film genres.",
