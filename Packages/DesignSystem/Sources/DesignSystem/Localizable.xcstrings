            "value": "Action"
          }
        }
      }
    },
    "theme.horror.description": {
      "comment": "One-line summary of a visual theme's mood.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Atmospheric dread, visceral intensity. Slow, tension-building motion over blood-red accents."
