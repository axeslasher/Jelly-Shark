<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated Info.plist (GENERATE_INFOPLIST_FILE stays YES).
	     NSAppTransportSecurity has to live here — it is a dict, and an
	     INFOPLIST_KEY_ build setting can only carry a scalar. The compliance key
	     below could go either way; it is here because the two are one decision
	     and reviewing them apart is worse than the inconsistency. -->

	<!-- The server is user-supplied, so there is no domain list to enumerate and
	     no way to require TLS: Jellyfin behind a TLS-less reverse proxy, a DDNS
	     name, or a tailnet hostname is a normal deployment. ATS exempts IP
	     literals and .local names on its own, which is why this only surfaced on
	     qualified hostnames (issue #273). NSAllowsLocalNetworking would not
	     cover an FQDN. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>

	<!-- The app uses only the OS's own TLS and ships no encryption of its own,
	     which is the standard exemption. Declaring it here means uploads skip
	     the per-build export-compliance hold in App Store Connect. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Local-network discovery (#282) broadcasts a UDP probe, which counts as a local
	     network operation. In practice only visionOS ever shows this prompt — tvOS has
	     no local-network privacy at all (TN3179) — but the key is harmless there and
	     belongs next to the other privacy keys rather than in a build setting. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Jelly Shark looks for Jellyfin servers on your network so you can pick yours instead of typing its address.</string>
</dict>
</plist>
